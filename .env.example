# ==============================================================================
# DeepSeek-V4-Pro / Qwen3.5 Local Autonomous Agentic Workspace Configuration
# Copy this file to `.env` and edit as needed.
# ==============================================================================

# --- AI Provider ---
# Set to "gemini" to run purely on Gemini API with ZERO local model downloads.
# Set to "local" to run local llama.cpp inference (auto-cached in ./models).
LLM_PROVIDER=local

# Optional Gemini API settings (required only when LLM_PROVIDER=gemini or switching to GEMINI in UI)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# If true, never downloads or launches local llama-server on startup (default: true when LLM_PROVIDER=gemini)
# SKIP_LOCAL_MODEL=false

# --- Persistent Local Model Cache ---
# Models are downloaded ONCE into MODELS_DIR and reused automatically on every run.
MODELS_DIR=./models
MODEL_REPO=mradermacher/DeepSeek-V4-Pro-Qwen3.5-9B-UNCENSORED-heretic-GGUF
QUANTIZATION=Q4_K_M
ENABLE_VISION_MMPROJ=true
MMPROJ_REPO=mradermacher/DeepSeek-V4-Pro-Qwen3.5-9B-UNCENSORED-heretic-GGUF

# Optional: point directly to an already-downloaded GGUF anywhere on your PC
# LOCAL_MODEL_PATH=/path/to/your-model.gguf
# LOCAL_MMPROJ_PATH=/path/to/mmproj-model.gguf
# LLAMA_SERVER_BIN=/path/to/llama-server

# --- Inference Settings ---
CONTEXT_SIZE=32768
TEMPERATURE=0.6
MAX_NEW_TOKENS_PER_CALL=8192
SOFT_CONTEXT_BUDGET=12000
# -1 = full GPU offload (CUDA / Apple Metal), 0 = CPU only
GPU_LAYERS=-1

# --- Workspace & Studio Server ---
WORKSPACE_DIR=./workspace
SERVER_HOST=127.0.0.1
SERVER_PORT=7860
LLM_HOST=127.0.0.1
LLM_PORT=8000

# --- Optional Features ---
ENABLE_CLOUDFLARE_TUNNEL=false
ENABLE_VIRTUAL_DESKTOP=false
BROWSER_HEADLESS=true
